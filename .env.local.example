# Supabase — auth, Postgres (users, videos metadata, follows, likes, comments)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random characters. Signs anonymous viewer identifiers used for
# ad frequency caps and watch-session attribution.
ANON_ID_SIGNING_SECRET=

# Cloudflare Stream — adaptive HLS transcoding + playback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Filled in by scripts/register-stream-webhook.mjs — run it once after
# CLOUDFLARE_STREAM_API_TOKEN is set and the app is deployed somewhere
# publicly reachable (Stream's webhook needs a real URL, not localhost).
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Cloudflare R2 — video thumbnails only (avatars/banners are Supabase Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Upstash Redis — rate limiting (lib/rate-limit.ts). Optional in local dev
# and CI; production mutating endpoints fail closed when either is unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron — set this in the Vercel dashboard, not here. Vercel
# automatically sends `Authorization: Bearer <CRON_SECRET>` on requests it
# makes to the paths listed in vercel.json's `crons`
# (src/app/api/internal/parties/notify-scheduled/route.ts checks it) — no
# manual header wiring needed once this is set on the deployed project.
CRON_SECRET=

# Sentry — error tracking (src/instrumentation.ts, src/instrumentation-client.ts).
# The SDK no-ops with no DSN set. NEXT_PUBLIC_SENTRY_DSN is the browser-side
# one; SENTRY_DSN covers server + edge. SENTRY_AUTH_TOKEN/ORG/PROJECT are only
# needed for source-map upload at build time (CI), not for the app to run.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
